# Copy to .env and provide separate random access tokens before starting.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
BACKEND_WEB_TOKEN=
BACKEND_DEVICE_TOKEN=
BACKEND_DEVICE_ID=typewriter
BACKEND_ALLOWED_ORIGINS=http://localhost:5173
BACKEND_DATA_DIR=.backend-data

# Base URL includes /v1 when required by the provider; no /chat/completions suffix.
BACKEND_MODEL_BASE_URL=
BACKEND_MODEL=
BACKEND_MODEL_API_KEY=
BACKEND_MODEL_REASONING_EFFORT=high
BACKEND_MODEL_TIMEOUT_MS=120000

# Alibaba Cloud Model Studio Qwen-ASR short recordings (not filetrans/realtime).
# Beijing default; Singapore: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Workspace-specific compatible-mode/v1 URLs can also be used. Keys must match the region.
BACKEND_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BACKEND_ASR_MODEL=qwen3-asr-flash
# Falls back to DASHSCOPE_API_KEY when empty. Never put this key in the web project.
BACKEND_ASR_API_KEY=
# Empty means automatic language detection; use zh or en to constrain recognition.
BACKEND_ASR_LANGUAGE=
BACKEND_ASR_TIMEOUT_MS=60000

BACKEND_HEARTBEAT_MS=5000
BACKEND_OFFLINE_MS=15000
BACKEND_TYPING_IDLE_MS=3000

# Used only by npm run backend:device (the simulated printer).
BACKEND_URL=http://127.0.0.1:3000

# Enable the KX-R530 host adapter; leave empty for the HTTP device simulator.
BACKEND_BOARD_HTTP_URL=
BACKEND_BOARD_WS_URL=ws://127.0.0.1:8766/api/v1/agent
# Calibrate to the paper and typewriter margins; long lines are wrapped using LF-CR.
BACKEND_BOARD_COLUMNS=60
